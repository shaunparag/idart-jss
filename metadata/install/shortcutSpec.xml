<?xml version="1.0" encoding="UTF-8" ?>
<shortcuts>
	<skipIfNotSupported />
	<programGroup defaultName="iDart" location="applications" />
	<shortcut
		name="iDART - Pharmacy"
		target="$INSTALL_PATH\go.bat"
		commandLine=""
		workingDirectory="$INSTALL_PATH"
		description="Starts the Cell-Life Intelligent Delivery for ART System"
		iconFile="$INSTALL_PATH\cLogo.ico"
		iconIndex="0"
		initialState="minimized"
		programGroup="yes"
		desktop="yes"
		applications="no"
		startMenu="no"
		startup="no">
		<createForPack name="Core" />
	</shortcut>

	<shortcut
		name="Uninstall"
		programGroup="yes"
		desktop="no"
		applications="no"
		startMenu="yes"
		startup="no"
		target="$INSTALL_PATH\uninstall.bat"
		workingDirectory="$INSTALL_PATH"
		commandLine=""
		initialState="minimized"
		iconFile="$INSTALL_PATH\cLogo.ico"
		iconIndex="0"
		type="Application"
		encoding="UTF-8"
		description="Uninstall">
		<createForPack name="Core" />
	</shortcut>

	<!-- Opens a console window (initialState normal) because pg_dump
	     asks for the database password there. -->
	<shortcut
		name="Backup iDART database"
		programGroup="yes"
		desktop="no"
		applications="no"
		startMenu="no"
		startup="no"
		target="$INSTALL_PATH\backup.bat"
		workingDirectory="$INSTALL_PATH"
		commandLine=""
		initialState="normal"
		iconFile="$INSTALL_PATH\cLogo.ico"
		iconIndex="0"
		type="Application"
		encoding="UTF-8"
		description="Back up the iDART database to the iDART-backups folder in your user profile">
		<createForPack name="Core" />
	</shortcut>
	
	
	
	<!-- Was target="acroread" with commandLine/url pointing at
	     doc/izpack/pdf/izpack-doc.pdf - IzPack's own tutorial PDF, which
	     this project never actually ships (leftover, never-customised
	     boilerplate from IzPack's sample shortcutSpec.xml). "acroread"
	     isn't a real Windows executable, and on the machine this was
	     tested on the resulting shortcut launched the uninstaller
	     instead. Points at help.bat now, which opens the real iDART
	     User Guide (the same JavaHelp helpset the in-app Help button
	     shows) via the standalone org.celllife.idart.start.HelpViewer
	     launcher. -->
	<shortcut
		name="Documentation"
		programGroup="yes"
		desktop="yes"
		applications="no"
		startMenu="yes"
		startup="no"
		target="$INSTALL_PATH\help.bat"
		workingDirectory="$INSTALL_PATH"
		commandLine=""
		initialState="normal"
		iconFile="$INSTALL_PATH\cLogo.ico"
		iconIndex="0"
		type="Application"
		encoding="UTF-8"
		description="iDART User Guide">
		<createForPack name="Documentation" />
	</shortcut>

</shortcuts>
