	<native type="izpack" name="ShellLink.dll" />
	<info>
		<appname>iDART</appname>
		<appversion>3.8.1</appversion>
		<authors>
			<author name="Samir Anand" email="samir@cell-life.org" />
			<author name="Sarah Brown" email="sarah@cell-life.org" />
			<author name="Jalal Ghiassi-Razavi" email="jalal@cell-life.org" />
			<author name="Nico Gevers" email="nico.gevers@cell-life.org" />
			<author name="Dirk de Jager" email="dirk@cell-life.org" />
			<author name="Nicola Killa" email="Nicola.Killa@hiv-research.org.za" />
			<author name="Melissa Loudon" email="melissa@cell-life.org" />
			<author name="Rashid Limbada" email="rashid@cell-life.org" />
			<author name="Simon Kelly" email="simon@cell-life.org" />
			<author name="Munaf Sheikh" email="munaf@cell-life.org" />
			<author name="Ilda Ladeira" email="ladeira.ilda@gmail.com" />
			<author name="Kavindra Rammungal" email="kavindra.r@gmail.com" />
			<author name="Stephen Rausch" email="stephenrausch@gmail.com" />
			<author name="Ulrike Rivett" email="ulrike@cell-life.org" />
			<author name="Robin Wood" email="Robin.Wood@hiv-research.org.za" />
		</authors>
		<url>http://www.cell-life.org/dispense-idart</url>
		<javaversion>1.5</javaversion>
		<!-- Deliberately NOT requesting <run-privileged/>. Two separate,
		     bytecode-confirmed facts about this vendored 2009-era IzPack
		     drive that:

		     1. InstallerBase.loadInstallData() unconditionally computes the
		        shown default install path (Windows: %ProgramFiles% or a
		        literal "C:\Program Files" fallback; Unix: /usr/local if
		        writable, else user.home) and overwrites INSTALL_PATH with
		        <that root>/<appname> as its very last step, with no check
		        for an existing value and no install.xml-level hook to
		        change it - confirmed by reading the bytecode and by two
		        separate empirical tests (overriding INSTALL_PATH directly,
		        and overriding APPLICATIONS_DEFAULT_ROOT) under Xvfb, both
		        silently ignored. So the default shown will always need
		        admin rights to accept as-is; that part alone would still
		        be a reason to request elevation.

		     2. But <run-privileged/>'s actual elevation mechanism on
		        Windows (PrivilegedRunner.getElevator(), confirmed by
		        disassembling the class directly) is "wscript <tmpdir>
		        \Installer.js <java> -Dizpack.mode=privileged -jar <jar>" -
		        a JScript file (elevate.js, bundled in this jar) run via
		        Windows Script Host, using the classic
		        Shell.ShellExecute(...,"runas") UAC trick. This runs from
		        INSIDE the already-launched installer process, so it fires
		        the same way whether the jar was double-clicked or started
		        with `java -jar` directly. On any Windows machine where the
		        WSH JScript engine has been disabled or unregistered - a
		        common lockdown on managed/enterprise PCs, and confirmed to
		        be the case on this app's actual target hardware - that
		        wscript call throws a native "There is no script engine for
		        file extension '.js'" dialog before the installer can even
		        continue, which then makes checkForPrivilegedExecution()
		        treat the relaunch as failed and show IzPack's own "could
		        not launch itself with administrator permissions" dialog
		        right after it. Both dialogs, same root cause, confirmed by
		        reading checkForPrivilegedExecution()'s bytecode end to end.

		     Given (2), requesting elevation isn't a no-op fallback when it
		     doesn't succeed - it actively breaks the installer's launch on
		     exactly the kind of locked-down machine this app is deployed
		     to. So: never attempt self-elevation.

		     That still leaves (1)'s Program-Files-rooted default, which an
		     unelevated installer can't write to. Fixed separately, without
		     fighting loadInstallData() at all: TargetPanel's own
		     constructor (a later, different code path - see
		     PathInputPanel.loadDefaultInstallDir()/getDefaultInstallDir(),
		     confirmed by disassembly and by an empirical Xvfb test using a
		     throwaway TargetPanel.dir.unix resource before this shipped)
		     re-reads idata's install path from a "TargetPanel.dir.windows"
		     resource, if present, and applies it via idata.setInstallPath()
		     - which sticks, since nothing runs loadInstallData() a second
		     time. See the TargetPanel.dir.windows resource below for the
		     actual default (a folder under the user's own profile, so no
		     admin rights are needed at all in the common case). Someone who
		     wants Program Files specifically can still type/Browse to it
		     and launch this jar from an already-elevated Command
		     Prompt/PowerShell themselves - the install-folder icacls grant
		     in process.xml covers that case so the app can still write to
		     it post-install without staying elevated. -->
	</info>
	<!-- height was 600: IzPack stacks each panel's rows top-to-bottom sized
	     to their content, so on a display with larger Windows font/DPI
	     scaling the finish screen's rows (message + uninstaller path +
	     "generate script" button) can add up to more than 600px and the
	     button overlaps the row above it. Extra height gives that slack;
	     resizable="yes" means this only affects the starting size. -->
	<guiprefs height="720" resizable="yes" width="800">
		<laf name="metouia">
			<os family="unix" />
		</laf>
		<laf name="looks">
			<os family="windows" />
			<param name="variant" value="plasticXP" />
		</laf>
	</guiprefs>
	<dynamicvariables>
		<variable name="dbUrl" value="jdbc:postgresql://$dbAddress:5432/$dbName" />
	</dynamicvariables>
	<variables>
		<variable name="DesktopShortcutCheckboxEnabled" value="true" />
	</variables>

	<locale>
		<langpack iso3="eng" />
	</locale>
	<resources>
		<res src="metadata/install/install-readme.html" id="HTMLInfoPanel.info" />
		<res src="metadata/install/Licence.html" id="HTMLLicencePanel.licence" />
		<res src="metadata/install/clinstall.jpg" id="Installer.image" />
		<res src="metadata/install/userInputSpec.xml" id="userInputSpec.xml" />
		<res src="metadata/install/conditions.xml" id="conditions.xml" />
		<res src="metadata/install/shortcutSpec.xml" id="shortcutSpec.xml" />
		<res src="metadata/install/process.xml" id="ProcessPanel.Spec.xml" />
		<!-- Overrides TargetPanel's shown default on Windows only (see the
		     <info> comment above for why); first line, IzPack variable
		     substitution applied. Unix/Mac are untouched - IzPack's own
		     built-in fallback there already picks a writable location. -->
		<res src="metadata/install/default-install-dir-windows.txt" id="TargetPanel.dir.windows" />
	</resources>
	<panels>
		<panel classname="HelloPanel" />
		<panel classname="HTMLInfoPanel" />
		<panel classname="HTMLLicencePanel" />
		<panel classname="PacksPanel" />
		<panel classname="UserInputPanel" id="path.panel1" />
		<panel classname="UserInputPanel" id="path.panel2" />
		<panel classname="UserInputPanel" id="path.panel3" />
		<panel classname="UserInputPanel" id="path.panel4" />
		<panel classname="UserInputPanel" id="path.panel5" />
		<panel classname="TargetPanel" />
		<panel classname="ShortcutPanel" os="Windows" />
		<panel classname="InstallPanel" />
		<panel classname="ProcessPanel" />
		<panel classname="FinishPanel" />
	</panels>
	<packs>
		<pack name="Core" required="yes">
			<description>iDART core files.</description>

			<!-- Common files -->
			<fileset dir="metadata/install" targetdir="$INSTALL_PATH">
				<include name="*.jar" />
				<include name="*.ttf" />
				<include name="aupVersion.txt" />
				<include name="*.html" />
				<include name="log4j.xml" />
				<include name="quartz.properties" />
				<include name="sms.properties" />
			</fileset>
			<fileset dir="metadata/database/" targetdir="$INSTALL_PATH/scripts">
				<include name="*diff.sql" />
				<include name="*_schema*.sql" />
				<include name="*training-data.sql" />
			</fileset>
			<fileset dir="metadata/database/database_cleanup_scripts"
				targetdir="$INSTALL_PATH/scripts">
				<include name="*.sql" />
			</fileset>
			<fileset dir="" targetdir="$INSTALL_PATH">
				<include name="Reports/**/*" />
				<exclude name="Reports/*.jrxml" />
				<include name="img/**/*" />
				<include name="unencrypted_idart.properties" />
			</fileset>
			<fileset dir="" targetdir="$INSTALL_PATH/bin">
				<include name="Pharmacy.jar" />
			</fileset>

			<!-- Windows only files -->
			<fileset dir="metadata/install" targetdir="$INSTALL_PATH" os="windows">
				<include name="*.bat" />
				<include name="*.dll" />
				<include name="*.ico" />
				<include name="*.png" />
				<include name="*.xls"/>
				<include name="Import_README.txt"/>
			</fileset>

			<!-- Unix only files -->
			<fileset dir="metadata/install" targetdir="$INSTALL_PATH" os="unix">
				<include name="*.sh" />
				<include name="*.so" />
				<include name="*.png" />
				<include name="*.xls"/>
				<include name="Cell-Life.desktop" />
				<include name="Import_README.txt"/>
			</fileset>
			<parsable targetfile="$INSTALL_PATH/uninstall.bat" type="plain"
				os="windows" />
			<parsable targetfile="$INSTALL_PATH/go.bat" type="plain" os="windows" />
			<parsable targetfile="$INSTALL_PATH/help.bat" type="plain"
				os="windows" />
			<parsable targetfile="$INSTALL_PATH/launcher.bat" type="plain"
				os="windows" />
			<parsable targetfile="$INSTALL_PATH/backup.bat" type="plain"
				os="windows" />
			<parsable targetfile="$INSTALL_PATH/uninstall.sh" type="shell"
				os="unix" />
			<parsable targetfile="$INSTALL_PATH/go.sh" type="shell" os="unix" />
			<parsable targetfile="$INSTALL_PATH/unixpostinstall.sh"
				type="shell" os="unix" />
			<parsable targetfile="$INSTALL_PATH/update.sh" type="shell"
				os="unix" />
			<parsable targetfile="$INSTALL_PATH/launcher.sh" type="shell"
				os="unix" />
			<parsable targetfile="$INSTALL_PATH/unencrypted_idart.properties"
				type="plain" />
			<parsable targetfile="$INSTALL_PATH/Cell-Life.desktop" type="plain"
				os="unix" />
			<executable targetfile="$INSTALL_PATH/go.sh" type="bin"
				stage="never" os="unix" />
			<executable targetfile="$INSTALL_PATH/uninstall.sh" type="bin"
				stage="never" os="unix" />
			<executable targetfile="$INSTALL_PATH/unixpostinstall.sh"
				type="bin" stage="postinstall" os="unix" />
			<executable targetfile="$INSTALL_PATH/update.sh" type="bin"
				stage="never" os="unix" />
			<executable targetfile="$INSTALL_PATH/backup.sh" type="bin"
				stage="never" os="unix" />
			<executable targetfile="$INSTALL_PATH/launcher.sh" type="bin"
				stage="never" os="unix" />
		</pack>
		<pack name="Libraries" required="yes">
			<description>3rd Party Library files.</description>
			<fileset dir="target/lib" targetdir="$INSTALL_PATH/lib">
				<include name="**/*.jar" />
				<exclude name="**/swt.jar" />
				<exclude name="**/swt-debug.jar" />
			</fileset>
			<file targetdir="$INSTALL_PATH/lib" os="windows" src="lib/swt_win/swt.jar" />
			<file targetdir="$INSTALL_PATH/lib" os="unix" src="lib/swt_gtk/swt.jar" />
		</pack>
		<pack name="Source" required="no">
			<description>iDART source files.</description>
			<fileset dir="" targetdir="$INSTALL_PATH">
				<include name="src/**/*" />
				<exclude name=".svn"/>
				<exclude name="_svn"/>
			</fileset>
		</pack>
		<pack name="Documentation" required="yes">
			<description>iDART User Documentation.</description>
			<fileset dir="metadata/" targetdir="$INSTALL_PATH">
				<include name="doc/**/*" />
			</fileset>
		</pack>
	</packs>
</installation>